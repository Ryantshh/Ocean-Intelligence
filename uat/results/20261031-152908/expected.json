  "c04": {
    "sql": "-- c04  \"Show me orders from PDM to North China.\"  (answered: Madeira)\n-- PDM is Ponta da Madeira, stored as Madeira. North China is a stored\n-- discharge label. No dates asked for.\nSELECT o.order_id::text AS id\nFROM order_test o\nWHERE o.date_received < $1::date + 1\n  AND o.load_port      ILIKE '%Madeira%'\n  AND o.discharge_port ILIKE '%North China%';\n",
    "ids": [],
    "count": 0
  },
  "v02": {
    "sql": "-- v02  \"Show me the ECSA ballasters.\"  (answered: East Coast South America)\n-- Each vessel at its latest report as of today, in ballast, open in East\n-- Coast South America. Not a list question, so no window.\nWITH latest AS (\n    SELECT DISTINCT ON (t.vessel_id) t.*\n    FROM tonnage_test t\n    WHERE t.update_date < $1::date + 1\n    ORDER BY t.vessel_id, t.update_date DESC, t.first_date_received DESC NULLS LAST\n)\nSELECT v.vessel_id AS id\nFROM latest v\nWHERE ('East Coast South America' = ANY (regexp_split_to_array(v.parent_zone, '\\s*,\\s*'))\n       OR v.open_area ILIKE '%East Coast South America%')\n  AND v.ballast_laden = 'BALLAST';\n",
